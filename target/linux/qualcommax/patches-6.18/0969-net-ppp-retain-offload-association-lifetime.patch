 #define ppp_unlock(ppp)		do { ppp_recv_unlock(ppp); \
 				     ppp_xmit_unlock(ppp); } while (0)
 
+static void ppp_offload_notify_unit(struct ppp *ppp)
+{
+	struct ppp_offload_event event = { .unit = ppp };
+
+	/* The caller retains its private unit reference across this call. */
+	srcu_notifier_call_chain(&ppp_offload_notifiers, 0, &event);
+}
+
+int ppp_offload_register_notifier(struct notifier_block *nb)
+{
+	return srcu_notifier_chain_register(&ppp_offload_notifiers, nb);
+}
+EXPORT_SYMBOL_GPL(ppp_offload_register_notifier);
+
+int ppp_offload_unregister_notifier(struct notifier_block *nb)
+{
+	return srcu_notifier_chain_unregister(&ppp_offload_notifiers, nb);
+}
+EXPORT_SYMBOL_GPL(ppp_offload_unregister_notifier);
+
+struct ppp_offload_ref *
+ppp_offload_ref_get(struct net_device *dev, struct ppp_offload_snapshot *snapshot)
+{
+	struct net_device_path_ctx ctx = { .dev = dev };
+	struct ppp_offload_ref *ref;
+	struct ppp_channel *chan;
+	struct channel *pch;
+	struct ppp *ppp;
+	int err;
+
+	ASSERT_RTNL();
+	memset(snapshot, 0, sizeof(*snapshot));
+	if (dev->netdev_ops != &ppp_netdev_ops ||
+	    dev->reg_state != NETREG_REGISTERED)
+		return ERR_PTR(-ENODEV);
+	ref = kzalloc_obj(*ref);
+	if (!ref)
+		return ERR_PTR(-ENOMEM);
+	dev_hold(dev);
+	ppp = netdev_priv(dev);
+	ppp_lock(ppp);
+	err = -ENODEV;
+	if (ppp->closing || ppp->n_channels != 1 || list_empty(&ppp->channels))
+		goto unlock_unit;
+	pch = list_first_entry(&ppp->channels, struct channel, clist);
+	refcount_inc(&pch->file.refcnt);
+	spin_lock_bh(&pch->downl);
+	chan = pch->chan;
+	if (rcu_access_pointer(pch->ppp) != ppp || pch->offload_closed || !chan)
+		goto unlock_channel;
+	err = -EOPNOTSUPP;
+	if (!chan->ops->fill_forward_path)
+		goto unlock_channel;
+	err = chan->ops->fill_forward_path(&ctx, &snapshot->path, chan);
+	if (err)
+		goto unlock_channel;
+	if (!ctx.dev || ctx.dev == dev) {
+		err = -ENODEV;
+		goto unlock_channel;
+	}
+	snapshot->lower_dev = (struct net_device *)ctx.dev;
+	dev_hold(snapshot->lower_dev);
+	snapshot->flags = ppp->flags;
+	snapshot->xstate = ppp->xstate;
+	snapshot->rstate = ppp->rstate;
+	snapshot->ipv4_mode = ppp->npmode[NP_IP];
+	snapshot->ipv6_mode = ppp->npmode[NP_IPV6];
+	snapshot->mru = ppp->mru;
+	snapshot->mtu = READ_ONCE(dev->mtu);
+	snapshot->channel_count = ppp->n_channels;
+	snapshot->vj = !!ppp->vj;
+	snapshot->tx_compression = !!ppp->xc_state;
+	snapshot->rx_compression = !!ppp->rc_state;
+#ifdef CONFIG_PPP_MULTILINK
+	snapshot->mrru = ppp->mrru;
+#endif
+#ifdef CONFIG_PPP_FILTER
+	snapshot->pass_filter = !!ppp->pass_filter;
+	snapshot->active_filter = !!ppp->active_filter;
+#endif
+	ref->dev = dev;
+	ref->channel = pch;
+	ref->generation = atomic64_read(&ppp->offload_generation);
+	spin_unlock_bh(&pch->downl);
+	ppp_unlock(ppp);
+	return ref;
+
+unlock_channel:
+	spin_unlock_bh(&pch->downl);
+	ppp_unlock(ppp);
+	if (refcount_dec_and_test(&pch->file.refcnt))
+		ppp_destroy_channel(pch);
+	goto free_ref;
+unlock_unit:
+	ppp_unlock(ppp);
+free_ref:
+	dev_put(dev);
+	kfree(ref);
+	memset(snapshot, 0, sizeof(*snapshot));
+	return ERR_PTR(err);
+}
+EXPORT_SYMBOL_GPL(ppp_offload_ref_get);
+
+bool ppp_offload_ref_valid(const struct ppp_offload_ref *ref)
+{
+	struct ppp *ppp = netdev_priv(ref->dev);
+	struct channel *pch = ref->channel;
+	bool valid;
+
+	ppp_lock(ppp);
+	spin_lock_bh(&pch->downl);
+	valid = !ppp->closing &&
+		atomic64_read(&ppp->offload_generation) == ref->generation &&
+		ppp->n_channels == 1 && !list_empty(&ppp->channels) &&
+		list_first_entry(&ppp->channels, struct channel, clist) == pch &&
+		rcu_access_pointer(pch->ppp) == ppp &&
+		!pch->offload_closed && pch->chan;
+	spin_unlock_bh(&pch->downl);
+	ppp_unlock(ppp);
+	return valid;
+}
+EXPORT_SYMBOL_GPL(ppp_offload_ref_valid);
+
+bool ppp_offload_ref_affected(const struct ppp_offload_ref *ref,
+			      const struct ppp_offload_event *event)
+{
+	return event->unit == netdev_priv(ref->dev) ||
+	       event->channel == ref->channel;
+}
+EXPORT_SYMBOL_GPL(ppp_offload_ref_affected);
+
+void ppp_offload_account(const struct ppp_offload_ref *ref,
+			 const struct ppp_offload_stats *delta)
+{
+	struct ppp *ppp = netdev_priv(ref->dev);
+	struct pcpu_sw_netstats *stats;
+
+	local_bh_disable();
+	stats = this_cpu_ptr(ref->dev->tstats);
+	u64_stats_update_begin(&stats->syncp);
+	u64_stats_add(&stats->rx_packets, delta->rx_packets);
+	u64_stats_add(&stats->rx_bytes, delta->rx_bytes);
+	u64_stats_add(&stats->tx_packets, delta->tx_packets);
+	u64_stats_add(&stats->tx_bytes, delta->tx_bytes);
+	u64_stats_update_end(&stats->syncp);
+	if (delta->rx_packets)
+		WRITE_ONCE(ppp->last_recv, jiffies);
+	if (delta->tx_packets)
+		WRITE_ONCE(ppp->last_xmit, jiffies);
+	local_bh_enable();
+}
+EXPORT_SYMBOL_GPL(ppp_offload_account);
+
+void ppp_offload_ref_put(struct ppp_offload_ref *ref)
+{
+	if (refcount_dec_and_test(&ref->channel->file.refcnt))
+		ppp_destroy_channel(ref->channel);
+	dev_put(ref->dev);
+	kfree(ref);
+}
+EXPORT_SYMBOL_GPL(ppp_offload_ref_put);
+
+void ppp_channel_offload_close(struct ppp_channel *chan)
+{
+	struct channel *pch = chan->ppp;
+	struct ppp_offload_event event;
+
+	if (!pch)
+		return;
+	refcount_inc(&pch->file.refcnt);
+	spin_lock_bh(&pch->downl);
+	pch->offload_closed = true;
+	spin_unlock_bh(&pch->downl);
+	event = (struct ppp_offload_event) { .channel = pch };
+	srcu_notifier_call_chain(&ppp_offload_notifiers, 0, &event);
+	if (refcount_dec_and_test(&pch->file.refcnt))
+		ppp_destroy_channel(pch);
+}
+EXPORT_SYMBOL_GPL(ppp_channel_offload_close);
