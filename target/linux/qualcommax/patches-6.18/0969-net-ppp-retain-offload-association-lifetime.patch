+struct ppp_offload_ref;
+struct ppp_offload_event;
+
+struct ppp_offload_snapshot {
+	unsigned int flags;
+	unsigned int xstate;
+	unsigned int rstate;
+	enum NPmode ipv4_mode;
+	enum NPmode ipv6_mode;
+	int mru;
+	int mrru;
+	int mtu;
+	unsigned int channel_count;
+	bool pass_filter;
+	bool active_filter;
+	bool vj;
+	bool tx_compression;
+	bool rx_compression;
+	struct net_device_path path;
+	struct net_device *lower_dev;
+};
+
+/* Hardware-only deltas in PPP payload bytes, excluding the protocol field. */
+struct ppp_offload_stats {
+	u64 rx_packets;
+	u64 rx_bytes;
+	u64 tx_packets;
+	u64 tx_bytes;
+};
+
+/* Get requires RTNL and a registered generic PPP device. On success the
+ * caller owns both the opaque reference and snapshot->lower_dev separately.
+ * Validity covers execution; an invalid reference remains usable for final
+ * accounting. Put neither acquires RTNL nor calls a protocol socket.
+ */
+struct ppp_offload_ref *
+ppp_offload_ref_get(struct net_device *dev, struct ppp_offload_snapshot *snapshot);
+bool ppp_offload_ref_valid(const struct ppp_offload_ref *ref);
+bool ppp_offload_ref_affected(const struct ppp_offload_ref *ref,
+			      const struct ppp_offload_event *event);
+void ppp_offload_account(const struct ppp_offload_ref *ref,
+			 const struct ppp_offload_stats *stats);
+void ppp_offload_ref_put(struct ppp_offload_ref *ref);
+
+/* Events are borrowed opaque identities. Callbacks can sleep, but must use
+ * retained execution references without acquiring RTNL or a PPP/socket control
+ * lock. They finish actual withdrawal/hold before returning; final accounting
+ * and access-end cleanup may continue independently. Return NOTIFY_DONE so all
+ * observers receive the event. Registration itself holds no unit reference.
+ */
+int ppp_offload_register_notifier(struct notifier_block *nb);
+int ppp_offload_unregister_notifier(struct notifier_block *nb);
+
+/* Process context, under the protocol's existing live-channel serialization.
+ * Call before clearing any field read by fill_forward_path. Repeated calls
+ * repeat the withdrawal observation; they do not reopen an old channel.
+ */
+void ppp_channel_offload_close(struct ppp_channel *chan);
+
