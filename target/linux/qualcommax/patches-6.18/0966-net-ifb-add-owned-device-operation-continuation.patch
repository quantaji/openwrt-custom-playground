--- /dev/null
+++ b/include/net/ifb.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _NET_IFB_H
+#define _NET_IFB_H
+
+#include <linux/netdevice.h>
+#include <net/flow_offload.h>
+
+struct ifb_binding;
+
+enum ifb_disposition { IFB_NATIVE, IFB_HOLD, IFB_DEVICE, IFB_DISPOSE };
+enum ifb_submit_status { IFB_ACCEPTED, IFB_RESOURCE_WAIT, IFB_CLOSED, IFB_REFUSED };
+struct ifb_ready {
+	enum ifb_submit_status status;
+	unsigned int resources;
+};
+
+/* query/ready/submit/progress and storage references are non-sleeping.
+ * query returns one retained actual operation only for IFB_DEVICE; ready and
+ * submit use that same operation, never a lookup of its replacement. arm must
+ * publish the actual recipient before requesting hardware resource progress.
+ * Callbacks into IFB progress run after the provider's resource locks release.
+ */
+struct ifb_provider_ops {
+	struct module *owner;
+	bool (*get)(void *private);
+	void (*put)(void *private);
+	enum ifb_disposition (*query)(void *private, u16 queue, void **operation);
+	bool (*operation_get)(void *operation);
+	void (*operation_put)(void *operation);
+	struct ifb_ready (*ready)(void *operation, size_t charge);
+	struct ifb_ready (*submit)(void *operation, struct sk_buff *skb);
+	void (*arm)(void *operation, struct ifb_binding *binding, u16 queue,
+		    unsigned int resources);
+	void (*disarm)(void *operation, u16 queue);
+	int (*setup_tc)(void *private, enum tc_setup_type type, void *data);
+	/* RTNL, real block/binder lifetime. BIND establishes the borrow without
+	 * replaying members; UNBIND ends it after native remove/count playback.
+	 * These callbacks never recursively unbind this provider registration.
+	 */
+	int (*setup_block)(void *private, struct tcf_block *block,
+			   enum flow_block_binder_type binder,
+			   enum tc_setup_type type, void *data);
+	int (*stop)(void *private);
+	/* Non-sleeping, locks released, provider storage/code still referenced.
+	 * Actual binding reference release is visible before this closing-only
+	 * progress notification; the callback must not inspect the old binding.
+	 */
+	void (*drained)(void *private);
+};
+
+/* RTNL. Idle registration owns storage, not a permanent module reference.
+ * Unbind closes admission first. -EINPROGRESS retains this exact binding until
+ * its accepted/ready/wait lifetime ends; call again after actual drain.
+ */
+struct ifb_binding *ifb_provider_bind(struct net_device *dev,
+		const struct ifb_provider_ops *ops, void *private);
+int ifb_provider_unbind(struct ifb_binding *binding);
+int ifb_provider_replay(struct ifb_binding *binding, struct tcf_block *block,
+		       enum flow_block_binder_type binder, bool add,
+		       struct netlink_ext_ack *extack);
+void ifb_tx_resource_progress(struct ifb_binding *binding, u16 queue);
+void ifb_tx_disposition_progress(struct ifb_binding *binding);
+
+/* Original cb is retained by the provider until one call. Every non-NULL
+ * returned skb is consumed. The caller still owns original storage unless it
+ * is the returned skb, and never reads its consumed cb after this call.
+ */
+void ifb_loan_complete(struct sk_buff *original, struct sk_buff *returned);
+void ifb_loan_dispose(struct sk_buff *original);
+/* Consumes skb and one source reference; only a proven completed native
+ * ingress position may use this entry. Frame data still includes mac_len.
+ */
+void ifb_fresh_ingress_continue(struct net_device *source, struct sk_buff *skb,
+				 u16 mac_len);
+
+#endif
