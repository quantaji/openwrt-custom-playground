@@ -1612,6 +1613,10 @@
 		    const struct net_bridge_port *p,
 		    u16 vid, u16 vid_range,
 		    int cmd);
+void br_vlan_notify_change(const struct net_bridge *br,
+			   const struct net_bridge_port *p,
+			   enum switchdev_vlan_change_scope scope,
+			   u16 vid_begin, u16 vid_end);
 bool br_vlan_can_enter_range(const struct net_bridge_vlan *v_curr,
 			     const struct net_bridge_vlan *range_end,
 			     u16 pvid);
@@ -1857,6 +1862,13 @@
 				  const struct net_bridge_port *p,
 				  u16 vid, u16 vid_range,
 				  int cmd)
+{
+}
+
+static inline void br_vlan_notify_change(const struct net_bridge *br,
+					 const struct net_bridge_port *p,
+					 enum switchdev_vlan_change_scope scope,
+					 u16 vid_begin, u16 vid_end)
 {
 }
 
--- a/net/bridge/br_vlan.c
+++ b/net/bridge/br_vlan.c
@@ -1904,6 +1904,23 @@
 		+ br_vlan_opts_nl_size(); /* bridge vlan options */
 }
 
+void br_vlan_notify_change(const struct net_bridge *br,
+			   const struct net_bridge_port *p,
+			   enum switchdev_vlan_change_scope scope,
+			   u16 vid_begin, u16 vid_end)
+{
+	struct switchdev_notifier_vlan_info info = {
+		.port = p ? p->dev : NULL,
+		.scope = scope,
+		.vid_begin = vid_begin,
+		.vid_end = vid_end,
+	};
+
+	ASSERT_RTNL();
+	call_switchdev_blocking_notifiers(SWITCHDEV_VLAN_CHANGED, br->dev,
+					  &info.info, NULL);
+}
+
 void br_vlan_notify(const struct net_bridge *br,
 		    const struct net_bridge_port *p,
 		    u16 vid, u16 vid_range,
@@ -1921,6 +1938,8 @@
 
 	/* right now notifications are done only with rtnl held */
 	ASSERT_RTNL();
+	br_vlan_notify_change(br, p, SWITCHDEV_VLAN_CHANGE_RANGE,
+			      vid, vid_range ? vid_range : vid);
 
 	if (p) {
 		ifindex = p->dev->ifindex;
--- a/net/bridge/br_vlan_options.c
+++ b/net/bridge/br_vlan_options.c
@@ -299,8 +299,11 @@
 
 		err = br_vlan_process_one_opts(br, p, vg, v, tb, &changed,
 					       extack);
-		if (err)
+		if (err) {
+			if (changed)
+				br_vlan_notify(br, p, vid, 0, RTM_NEWVLAN);
 			break;
+		}
 
 		if (changed) {
 			/* vlan options changed, check for range */
--- a/net/bridge/br_mst.c
+++ b/net/bridge/br_mst.c
@@ -186,6 +186,8 @@
 			br_mst_vlan_sync_state(pv, msti);
 	}
 
+	br_vlan_notify_change(mv->br, NULL, SWITCHDEV_VLAN_CHANGE_RANGE,
+			      mv->vid, mv->vid);
 	return 0;
 }
 
@@ -236,6 +238,7 @@
 		static_branch_dec(&br_mst_used);
 
 	br_opt_toggle(br, BROPT_MST_ENABLED, on);
+	br_vlan_notify_change(br, NULL, SWITCHDEV_VLAN_CHANGE_BRIDGE, 0, 0);
 	return 0;
 }
 
@@ -328,7 +331,10 @@
 	msti = nla_get_u16(tb[IFLA_BRIDGE_MST_ENTRY_MSTI]);
 	state = nla_get_u8(tb[IFLA_BRIDGE_MST_ENTRY_STATE]);
 
-	return br_mst_set_state(p, msti, state, extack);
+	err = br_mst_set_state(p, msti, state, extack);
+	if (!err)
+		br_vlan_notify_change(p->br, p, SWITCHDEV_VLAN_CHANGE_PORT, 0, 0);
+	return err;
 }
 
