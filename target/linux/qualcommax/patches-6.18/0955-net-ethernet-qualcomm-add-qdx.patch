Subject: [PATCH] net: qualcomm: build QDX peers and keep native callers reachable

Build qdx-drv and five independent Linux subsystem peers in sibling
source directories. The driver owns shared firmware and dataplane services;
peer Kconfig dependencies follow their native subsystem, not one another.
Native EDMA and 802.11ax PPE may operate without QDX; when QDX is modular,
cap these callers at module linkage so direct references remain reachable.

Updates the existing Phase 1 QDX build integration for the approved Phase 2
file organization. The CONFIG_QDX symbol and native reachability rule remain.

Signed-off-by: Codex

--- a/drivers/net/ethernet/qualcomm/Kconfig
+++ b/drivers/net/ethernet/qualcomm/Kconfig
@@ -77,16 +77,24 @@
 
 config QCOM_80211AX_PPE
 	tristate "Qualcomm 802.11ax PPE switch driver"
+	depends on QDX || !QDX
 	select PHYLINK
 	help
 	  Driver for Qualcomm 802.11ax PPE (Packet Processing Engine) switches.
 
 config QCOM_EDMA
 	tristate "EDMA dataplane ethernet driver for Qualcomm IPQ platforms"
+	depends on QDX || !QDX
 	help
 	  EDMA dataplane ethernet driver for Qualcomm IPQ platforms.
 
 
+source "drivers/net/ethernet/qualcomm/qdx-drv/Kconfig"
+source "drivers/net/ethernet/qualcomm/qdx-flow/Kconfig"
+source "drivers/net/ethernet/qualcomm/qdx-tc/Kconfig"
+source "drivers/net/ethernet/qualcomm/qdx-bridge/Kconfig"
+source "drivers/net/ethernet/qualcomm/qdx-vlan/Kconfig"
+source "drivers/net/ethernet/qualcomm/qdx-tunnel/Kconfig"
 source "drivers/net/ethernet/qualcomm/rmnet/Kconfig"
 
 endif # NET_VENDOR_QUALCOMM
--- a/drivers/net/ethernet/qualcomm/Makefile
+++ b/drivers/net/ethernet/qualcomm/Makefile
@@ -13,6 +13,12 @@
 obj-$(CONFIG_QCOM_EDMA) += qca_edma.o
 
 obj-y += emac/
+obj-$(CONFIG_QDX) += qdx-drv/
+obj-$(CONFIG_QDX_FLOW) += qdx-flow/
+obj-$(CONFIG_QDX_TC) += qdx-tc/
+obj-$(CONFIG_QDX_BRIDGE) += qdx-bridge/
+obj-$(CONFIG_QDX_VLAN) += qdx-vlan/
+obj-$(CONFIG_QDX_TUNNEL) += qdx-tunnel/
 
 obj-$(CONFIG_QCOM_PPE) += ppe/
 obj-$(CONFIG_RMNET) += rmnet/
