Subject: [PATCH] net: dsa: retain capable port queue and OOB selection

Let an implementing switch own its real port block callbacks and choose a
user TX queue. Preserve the existing dispatch for switches without these
operations. Separate allocated capacity from the initial real queue prefix
before native qdisc creation. Extend the inherited OOB tag with the selected
user queue and immutable execution identity; the conduit still selects and
accounts its own TX queue.

This extends the OOB implementation from Maxime Chevallier's
commit a32e16b3c2fc1954ad6e09737439f60e5890278e, preserved separately in 0950.
No generic packet interception or qdisc policy is added here.

Signed-off-by: Codex

--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -96,6 +96,7 @@
 };
 
 struct dsa_switch;
+struct dsa_oob_tag_info;
 
 struct dsa_device_ops {
 	struct sk_buff *(*xmit)(struct sk_buff *skb, struct net_device *dev);
@@ -497,6 +498,10 @@
 
 	/* Number of switch port queues */
 	unsigned int		num_tx_queues;
+	/* Zero preserves the allocated-count default. A smaller initial prefix
+	 * leaves real capacity for explicit hardware class queues.
+	 */
+	unsigned int		initial_real_num_tx_queues;
 
 	/* Drivers that benefit from having an ID associated with each
 	 * offloaded LAG should set this to the maximum number of
@@ -1132,6 +1137,17 @@
 	void	(*port_policer_del)(struct dsa_switch *ds, int port);
 	int	(*port_setup_tc)(struct dsa_switch *ds, int port,
 				 enum tc_setup_type type, void *type_data);
+	/* Optional capable-port block ownership; legacy dispatch is unchanged. */
+	int	(*port_setup_tc_block)(struct dsa_switch *ds, int port,
+				       struct flow_block_offload *offload);
+	u16	(*port_select_queue)(struct dsa_switch *ds, int port,
+				     struct sk_buff *skb, struct net_device *sb_dev);
+	/* Called by the OOB tagger after the user qdisc chose its real queue.
+	 * Copies native selection identity, never a borrowed object pointer.
+	 */
+	int	(*port_oob_tx_tag)(struct dsa_switch *ds, int port,
+				   const struct sk_buff *skb,
+				   struct dsa_oob_tag_info *tag);
 
 	/*
 	 * Cross-chip operations
--- a/net/dsa/user.c
+++ b/net/dsa/user.c
@@ -1738,6 +1738,8 @@
 
 	switch (type) {
 	case TC_SETUP_BLOCK:
+		if (ds->ops->port_setup_tc_block)
+			return ds->ops->port_setup_tc_block(ds, dp->index, type_data);
 		return dsa_user_setup_tc_block(dev, type_data);
 	case TC_SETUP_FT:
 		return dsa_user_setup_ft_block(ds, dp->index, type_data);
@@ -2585,6 +2587,17 @@
 	return ds->ops->port_hwtstamp_set(ds, dp->index, cfg, extack);
 }
 
+static u16 dsa_user_select_queue(struct net_device *dev, struct sk_buff *skb,
+				 struct net_device *sb_dev)
+{
+	struct dsa_port *dp = dsa_user_to_port(dev);
+	struct dsa_switch *ds = dp->ds;
+
+	if (ds->ops->port_select_queue)
+		return ds->ops->port_select_queue(ds, dp->index, skb, sb_dev);
+	return netdev_pick_tx(dev, skb, sb_dev);
+}
+
 static const struct net_device_ops dsa_user_netdev_ops = {
 	.ndo_open		= dsa_user_open,
 	.ndo_stop		= dsa_user_close,
@@ -2601,6 +2614,7 @@
 	.ndo_poll_controller	= dsa_user_poll_controller,
 #endif
 	.ndo_setup_tc		= dsa_user_setup_tc,
+	.ndo_select_queue	= dsa_user_select_queue,
 	.ndo_get_stats64	= dsa_user_get_stats64,
 	.ndo_vlan_rx_add_vid	= dsa_user_vlan_rx_add_vid,
 	.ndo_vlan_rx_kill_vid	= dsa_user_vlan_rx_kill_vid,
@@ -2784,6 +2798,13 @@
 	if (user_dev == NULL)
 		return -ENOMEM;
 
+	if (ds->initial_real_num_tx_queues) {
+		ret = netif_set_real_num_tx_queues(user_dev,
+						  ds->initial_real_num_tx_queues);
+		if (ret)
+			goto out_free;
+	}
+
 	user_dev->rtnl_link_ops = &dsa_link_ops;
 	user_dev->ethtool_ops = &dsa_user_ethtool_ops;
 #if IS_ENABLED(CONFIG_DCB)
--- a/include/linux/dsa/oob.h
+++ b/include/linux/dsa/oob.h
@@ -7,8 +7,15 @@
 
 #include <linux/skbuff.h>
 
+enum dsa_oob_tx_disposition {
+	DSA_OOB_TX_NATIVE, DSA_OOB_TX_OPTIONAL, DSA_OOB_TX_REQUIRED,
+};
+
 struct dsa_oob_tag_info {
+	u64 token;
 	u16 port;
+	u16 user_queue;
+	u8 disposition;
 };
 
 int dsa_oob_tag_push(struct sk_buff *skb, struct dsa_oob_tag_info *ti);
--- a/net/dsa/tag_oob.c
+++ b/net/dsa/tag_oob.c
@@ -19,7 +19,14 @@
 	if (!tag_info)
 		return NULL;
 
-	tag_info->port = dp->index;
+	*tag_info = (struct dsa_oob_tag_info) {
+		.port = dp->index,
+		.user_queue = skb_get_queue_mapping(skb),
+		.disposition = DSA_OOB_TX_NATIVE,
+	};
+	if (dp->ds->ops->port_oob_tx_tag &&
+	    dp->ds->ops->port_oob_tx_tag(dp->ds, dp->index, skb, tag_info))
+		return NULL;
 
 	return skb;
 }
