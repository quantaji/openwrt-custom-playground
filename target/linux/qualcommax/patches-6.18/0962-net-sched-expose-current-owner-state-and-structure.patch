diff --git a/kernel/bpf/tcx.c b/kernel/bpf/tcx.c
index efd987e..8fd2ee3 100644
--- a/kernel/bpf/tcx.c
+++ b/kernel/bpf/tcx.c
@@ -7,6 +7,14 @@
 
 #include <net/tcx.h>
 
+static void tcx_notify_change(struct net_device *dev, bool ingress,
+			      bool old_active, struct bpf_mprog_entry *entry)
+{
+	if (old_active != (entry && bpf_mprog_total(entry)))
+		netdev_tc_change(dev, ingress ? NETDEV_TC_INGRESS : NETDEV_TC_EGRESS);
+}
+
+
 int tcx_prog_attach(const union bpf_attr *attr, struct bpf_prog *prog)
 {
 	bool created, ingress = attr->attach_type == BPF_TCX_INGRESS;
@@ -14,6 +22,7 @@ int tcx_prog_attach(const union bpf_attr *attr, struct bpf_prog *prog)
 	struct bpf_mprog_entry *entry, *entry_new;
 	struct bpf_prog *replace_prog = NULL;
 	struct net_device *dev;
+	bool old_active;
 	int ret;
 
 	rtnl_lock();
@@ -36,6 +45,7 @@ int tcx_prog_attach(const union bpf_attr *attr, struct bpf_prog *prog)
 		ret = -ENOMEM;
 		goto out;
 	}
+	old_active = bpf_mprog_total(entry);
 	ret = bpf_mprog_attach(entry, &entry_new, prog, NULL, replace_prog,
 			       attr->attach_flags, attr->relative_fd,
 			       attr->expected_revision);
@@ -45,6 +55,7 @@ int tcx_prog_attach(const union bpf_attr *attr, struct bpf_prog *prog)
 			tcx_entry_sync();
 			tcx_skeys_inc(ingress);
 		}
+		tcx_notify_change(dev, ingress, old_active, entry_new);
 		bpf_mprog_commit(entry);
 	} else if (created) {
 		tcx_entry_free(entry);
@@ -62,6 +73,7 @@ int tcx_prog_detach(const union bpf_attr *attr, struct bpf_prog *prog)
 	struct net *net = current->nsproxy->net_ns;
 	struct bpf_mprog_entry *entry, *entry_new;
 	struct net_device *dev;
+	bool old_active;
 	int ret;
 
 	rtnl_lock();
@@ -75,6 +87,7 @@ int tcx_prog_detach(const union bpf_attr *attr, struct bpf_prog *prog)
 		ret = -ENOENT;
 		goto out;
 	}
+	old_active = bpf_mprog_total(entry);
 	ret = bpf_mprog_detach(entry, &entry_new, prog, NULL, attr->attach_flags,
 			       attr->relative_fd, attr->expected_revision);
 	if (!ret) {
@@ -83,6 +96,7 @@ int tcx_prog_detach(const union bpf_attr *attr, struct bpf_prog *prog)
 		tcx_entry_update(dev, entry_new, ingress);
 		tcx_entry_sync();
 		tcx_skeys_dec(ingress);
+		tcx_notify_change(dev, ingress, old_active, entry_new);
 		bpf_mprog_commit(entry);
 		if (!entry_new)
 			tcx_entry_free(entry);
@@ -98,16 +112,18 @@ void tcx_uninstall(struct net_device *dev, bool ingress)
 	struct bpf_tuple tuple = {};
 	struct bpf_mprog_fp *fp;
 	struct bpf_mprog_cp *cp;
-	bool active;
+	bool active, old_active;
 
 	entry = tcx_entry_fetch(dev, ingress);
 	if (!entry)
 		return;
+	old_active = bpf_mprog_total(entry);
 	active = tcx_entry(entry)->miniq_active;
 	if (active)
 		bpf_mprog_clear_all(entry, &entry_new);
 	tcx_entry_update(dev, entry_new, ingress);
 	tcx_entry_sync();
+	tcx_notify_change(dev, ingress, old_active, entry_new);
 	bpf_mprog_foreach_tuple(entry, fp, cp, tuple) {
 		if (tuple.link)
 			tcx_link(tuple.link)->dev = NULL;
@@ -145,12 +161,14 @@ static int tcx_link_prog_attach(struct bpf_link *link, u32 flags, u32 id_or_fd,
 	bool created, ingress = link->attach_type == BPF_TCX_INGRESS;
 	struct bpf_mprog_entry *entry, *entry_new;
 	struct net_device *dev = tcx->dev;
+	bool old_active;
 	int ret;
 
 	ASSERT_RTNL();
 	entry = tcx_entry_fetch_or_create(dev, ingress, &created);
 	if (!entry)
 		return -ENOMEM;
+	old_active = bpf_mprog_total(entry);
 	ret = bpf_mprog_attach(entry, &entry_new, link->prog, link, NULL, flags,
 			       id_or_fd, revision);
 	if (!ret) {
@@ -159,6 +177,7 @@ static int tcx_link_prog_attach(struct bpf_link *link, u32 flags, u32 id_or_fd,
 			tcx_entry_sync();
 			tcx_skeys_inc(ingress);
 		}
+		tcx_notify_change(dev, ingress, old_active, entry_new);
 		bpf_mprog_commit(entry);
 	} else if (created) {
 		tcx_entry_free(entry);
@@ -172,6 +191,7 @@ static void tcx_link_release(struct bpf_link *link)
 	bool ingress = link->attach_type == BPF_TCX_INGRESS;
 	struct bpf_mprog_entry *entry, *entry_new;
 	struct net_device *dev;
+	bool old_active;
 	int ret = 0;
 
 	rtnl_lock();
@@ -183,6 +203,7 @@ static void tcx_link_release(struct bpf_link *link)
 		ret = -ENOENT;
 		goto out;
 	}
+	old_active = bpf_mprog_total(entry);
 	ret = bpf_mprog_detach(entry, &entry_new, link->prog, link, 0, 0, 0);
 	if (!ret) {
 		if (!tcx_entry_is_active(entry_new))
@@ -190,6 +211,7 @@ static void tcx_link_release(struct bpf_link *link)
 		tcx_entry_update(dev, entry_new, ingress);
 		tcx_entry_sync();
 		tcx_skeys_dec(ingress);
+		tcx_notify_change(dev, ingress, old_active, entry_new);
 		bpf_mprog_commit(entry);
 		if (!entry_new)
 			tcx_entry_free(entry);
