From: Codex
Subject: [PATCH] net: sched: expose current owner state and committed structure

Expose optional native owner replay and independent device-stage capability.
Notify committed qdisc/STAB and TCX occupancy changes without a packet hook.
The original native algorithms and unsupported-device behavior remain intact.

Signed-off-by: Codex
---
diff --git a/include/linux/netdevice.h b/include/linux/netdevice.h
index adb821e..35af649 100644
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -952,6 +952,8 @@ enum tc_setup_type {
 	TC_SETUP_QDISC_FIFO,
 	TC_SETUP_QDISC_HTB,
 	TC_SETUP_ACT,
+	TC_SETUP_QDISC_CODEL,
+	TC_SETUP_QDISC_FQ_CODEL,
 };
 
 /* These structures hold the attributes of bpf state that are being passed
@@ -3196,6 +3198,7 @@ enum netdev_cmd {
 	NETDEV_OFFLOAD_XSTATS_REPORT_USED,
 	NETDEV_OFFLOAD_XSTATS_REPORT_DELTA,
 	NETDEV_XDP_FEAT_CHANGE,
+	NETDEV_CHANGE_TC,
 };
 const char *netdev_cmd_to_name(enum netdev_cmd cmd);
 
@@ -3216,6 +3219,15 @@ struct netdev_notifier_info {
 	struct netlink_ext_ack	*extack;
 };
 
+/* Committed processing changes; listeners cannot veto the native mutation. */
+#define NETDEV_TC_INGRESS BIT(0)
+#define NETDEV_TC_EGRESS  BIT(1)
+
+struct netdev_notifier_tc_info {
+	struct netdev_notifier_info info;
+	u8 directions;
+};
+
 struct netdev_notifier_info_ext {
 	struct netdev_notifier_info info; /* must be first */
 	union {
@@ -3305,6 +3317,17 @@ int call_netdevice_notifiers(unsigned long val, struct net_device *dev);
 int call_netdevice_notifiers_info(unsigned long val,
 				  struct netdev_notifier_info *info);
 
+/* RTNL; the native owner has committed the change and still holds its objects. */
+static inline void netdev_tc_change(struct net_device *dev, u8 directions)
+{
+	struct netdev_notifier_tc_info change = {
+		.info.dev = dev,
+		.directions = directions,
+	};
+
+	call_netdevice_notifiers_info(NETDEV_CHANGE_TC, &change.info);
+}
+
 #define for_each_netdev(net, d)		\
 		list_for_each_entry(d, &(net)->dev_base_head, dev_list)
 #define for_each_netdev_reverse(net, d)	\
