diff --git a/net/sched/sch_api.c b/net/sched/sch_api.c
index f56b18c..dfe993a 100644
--- a/net/sched/sch_api.c
+++ b/net/sched/sch_api.c
@@ -813,6 +813,35 @@ void qdisc_tree_reduce_backlog(struct Qdisc *sch, int n, int len)
 }
 EXPORT_SYMBOL(qdisc_tree_reduce_backlog);
 
+int qdisc_offload_replay(struct Qdisc *sch, unsigned long cl,
+			 flow_setup_cb_t *cb, void *cb_priv,
+			 struct netlink_ext_ack *extack)
+{
+	ASSERT_RTNL();
+	if (cl) {
+		const struct Qdisc_class_ops *ops = sch->ops->cl_ops;
+
+		if (!ops || !ops->offload_replay)
+			return -EOPNOTSUPP;
+		return ops->offload_replay(sch, cl, cb, cb_priv, extack);
+	}
+	if (!sch->ops->offload_replay)
+		return -EOPNOTSUPP;
+	return sch->ops->offload_replay(sch, cb, cb_priv, extack);
+}
+EXPORT_SYMBOL_GPL(qdisc_offload_replay);
+
+void qdisc_offload_change(struct Qdisc *sch)
+{
+	/* The ingress attachment can own both clsact directions. */
+	u8 directions = NETDEV_TC_EGRESS;
+
+	if (sch->flags & TCQ_F_INGRESS)
+		directions |= NETDEV_TC_INGRESS;
+	netdev_tc_change(qdisc_dev(sch), directions);
+}
+EXPORT_SYMBOL_GPL(qdisc_offload_change);
+
 int qdisc_offload_dump_helper(struct Qdisc *sch, enum tc_setup_type type,
 			      void *type_data)
 {
@@ -1144,6 +1173,7 @@ static int qdisc_graft(struct net_device *dev, struct Qdisc *parent,
 			 * pointer(s) in mini_qdisc_pair_swap().
 			 */
 			qdisc_notify(net, skb, n, classid, old, new, extack);
+			netdev_tc_change(dev, NETDEV_TC_INGRESS | NETDEV_TC_EGRESS);
 			qdisc_destroy(old);
 
 			dev_graft_qdisc(dev_queue, new);
@@ -1155,6 +1185,7 @@ skip:
 			if (new && !new->ops->attach)
 				qdisc_refcount_inc(new);
 			rcu_assign_pointer(dev->qdisc, new ? : &noop_qdisc);
+			netdev_tc_change(dev, NETDEV_TC_EGRESS);
 
 			notify_and_destroy(net, skb, n, classid, old, new, extack);
 
@@ -1196,6 +1227,7 @@ skip:
 		err = cops->graft(parent, cl, new, &old, extack);
 		if (err)
 			return err;
+		qdisc_offload_change(parent);
 		notify_and_destroy(net, skb, n, classid, old, new, extack);
 	}
 	return 0;
@@ -1381,6 +1413,7 @@ static int qdisc_change(struct Qdisc *sch, struct nlattr **tca,
 		err = sch->ops->change(sch, tca[TCA_OPTIONS], extack);
 		if (err)
 			return err;
+		qdisc_offload_change(sch);
 	}
 
 	if (tca[TCA_STAB]) {
@@ -1391,6 +1424,8 @@ static int qdisc_change(struct Qdisc *sch, struct nlattr **tca,
 
 	ostab = rtnl_dereference(sch->stab);
 	rcu_assign_pointer(sch->stab, stab);
+	if (ostab != stab)
+		qdisc_offload_change(sch);
 	qdisc_put_stab(ostab);
 
 	if (tca[TCA_RATE]) {
