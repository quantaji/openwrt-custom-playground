From: Codex
Subject: [PATCH] net: sched: export effective parameters and native queue choice

Use the same native builders for setup and replay. Preserve software
algorithms, expose their effective inputs, and retain the synchronous HTB
queue protocol and actual successful PRIO dequeue identity.

Signed-off-by: Codex
---
diff --git a/include/net/pkt_cls.h b/include/net/pkt_cls.h
index f8fe4ea..36af122 100644
--- a/include/net/pkt_cls.h
+++ b/include/net/pkt_cls.h
@@ -889,6 +889,20 @@ struct tc_htb_qopt_offload {
 	u64 rate;
 	u64 ceil;
 	u8 prio;
+	struct tc_qdisc_offload_owner owner;
+	/* Effective native policy and actual borrowed identities, device-stage caps. */
+	struct psched_ratecfg ratecfg;
+	struct psched_ratecfg ceilcfg;
+	s64 buffer_ns;
+	s64 ceil_buffer_ns;
+	unsigned long parent_class;
+	struct Qdisc *child;
+	u32 root_handle;
+	u16 default_class;
+	u32 effective_quantum;
+	u32 effective_prio;
+	bool explicit_offload;
+	bool leaf;
 };
 
 #define TC_HTB_CLASSID_ROOT U32_MAX
@@ -910,6 +924,12 @@ struct tc_red_qopt_offload_params {
 	bool is_harddrop;
 	bool is_nodrop;
 	struct gnet_stats_queue *qstats;
+	u8 Wlog;
+	u8 flags;
+	bool adaptive;
+	struct tcf_block *early_drop_block;
+	struct tcf_block *mark_block;
+	struct Qdisc *child;
 };
 
 struct tc_red_qopt_offload {
@@ -922,6 +942,7 @@ struct tc_red_qopt_offload {
 		struct red_stats *xstats;
 		u32 child_handle;
 	};
+	struct tc_qdisc_offload_owner owner;
 };
 
 enum tc_gred_command {
@@ -982,6 +1003,7 @@ struct tc_prio_qopt_offload_params {
 	 * qlen need to be reduced by the portion that is in HW.
 	 */
 	struct gnet_stats_queue *qstats;
+	struct Qdisc *children[TCQ_PRIO_BANDS];
 };
 
 struct tc_prio_qopt_offload_graft_params {
@@ -998,6 +1020,7 @@ struct tc_prio_qopt_offload {
 		struct tc_qopt_offload_stats stats;
 		struct tc_prio_qopt_offload_graft_params graft_params;
 	};
+	struct tc_qdisc_offload_owner owner;
 };
 
 enum tc_root_command {
@@ -1052,6 +1075,12 @@ struct tc_tbf_qopt_offload_replace_params {
 	struct psched_ratecfg rate;
 	u32 max_size;
 	struct gnet_stats_queue *qstats;
+	struct psched_ratecfg peak;
+	s64 buffer_ns;
+	s64 peak_buffer_ns;
+	u32 burst;
+	u32 peak_burst;
+	struct Qdisc *child;
 };
 
 struct tc_tbf_qopt_offload {
@@ -1063,6 +1092,7 @@ struct tc_tbf_qopt_offload {
 		struct tc_qopt_offload_stats stats;
 		u32 child_handle;
 	};
+	struct tc_qdisc_offload_owner owner;
 };
 
 enum tc_fifo_command {
@@ -1078,6 +1108,49 @@ struct tc_fifo_qopt_offload {
 	union {
 		struct tc_qopt_offload_stats stats;
 	};
+	struct tc_qdisc_offload_owner owner;
+	u32 limit;
+	bool byte_limit;
+	bool head_drop;
+};
+
+enum tc_codel_command {
+	TC_CODEL_REPLACE,
+	TC_CODEL_DESTROY,
+	TC_CODEL_STATS,
+};
+
+struct tc_codel_qopt_offload_params {
+	/* Native codel_time_t values, in units of 1 << CODEL_SHIFT nanoseconds. */
+	u32 target;
+	u32 interval;
+	u32 ce_threshold;
+	u32 limit;
+	u32 mtu;
+	u8 ce_threshold_selector;
+	u8 ce_threshold_mask;
+	bool ecn;
+};
+
+struct tc_codel_qopt_offload {
+	enum tc_codel_command command;
+	u32 handle;
+	u32 parent;
+	struct tc_codel_qopt_offload_params set;
+	struct tc_qdisc_offload_owner owner;
+};
+
+struct tc_fq_codel_qopt_offload {
+	enum tc_codel_command command;
+	u32 handle;
+	u32 parent;
+	struct tc_codel_qopt_offload_params codel;
+	u32 flows;
+	u32 quantum;
+	u32 memory_limit;
+	u32 drop_batch_size;
+	struct tcf_block *block;
+	struct tc_qdisc_offload_owner owner;
 };
 
 #ifdef CONFIG_NET_CLS_ACT
diff --git a/net/sched/sch_codel.c b/net/sched/sch_codel.c
index b284f8e..a6d244d 100644
--- a/net/sched/sch_codel.c
+++ b/net/sched/sch_codel.c
@@ -18,6 +18,7 @@
 #include <linux/skbuff.h>
 #include <linux/prefetch.h>
 #include <net/pkt_sched.h>
+#include <net/pkt_cls.h>
 #include <net/codel.h>
 #include <net/codel_impl.h>
 #include <net/codel_qdisc.h>
@@ -32,6 +33,59 @@ struct codel_sched_data {
 	u32			drop_overlimit;
 };
 
+static void codel_offload_prepare(struct Qdisc *sch,
+				    struct tc_codel_qopt_offload *opt)
+{
+	struct codel_sched_data *q = qdisc_priv(sch);
+
+	*opt = (struct tc_codel_qopt_offload) {
+		.command = TC_CODEL_REPLACE,
+		.handle = sch->handle,
+		.parent = sch->parent,
+		.owner = { .sch = sch, .hw_stats = &sch->hw_stats },
+		.set = {
+			.target = q->params.target,
+			.interval = q->params.interval,
+			.ce_threshold = q->params.ce_threshold,
+			.limit = sch->limit,
+			.mtu = q->params.mtu,
+			.ecn = q->params.ecn,
+			.ce_threshold_selector = q->params.ce_threshold_selector,
+			.ce_threshold_mask = q->params.ce_threshold_mask,
+		},
+	};
+}
+
+static int codel_offload_replay(struct Qdisc *sch, flow_setup_cb_t *cb,
+				 void *priv, struct netlink_ext_ack *extack)
+{
+	struct tc_codel_qopt_offload opt;
+
+	codel_offload_prepare(sch, &opt);
+	return cb(TC_SETUP_QDISC_CODEL, &opt, priv);
+}
+
+static void codel_offload(struct Qdisc *sch, enum tc_codel_command command)
+{
+	struct net_device *dev = qdisc_dev(sch);
+	struct tc_codel_qopt_offload opt;
+	struct tc_qdisc_caps caps;
+
+	if (command == TC_CODEL_STATS)
+		sch->flags &= ~TCQ_F_OFFLOADED;
+	if (!tc_can_offload(dev) || !dev->netdev_ops->ndo_setup_tc)
+		return;
+	qdisc_offload_query_caps(dev, TC_SETUP_QDISC_CODEL, &caps, sizeof(caps));
+	if (!caps.device_stage)
+		return;
+	codel_offload_prepare(sch, &opt);
+	opt.command = command;
+	if (command == TC_CODEL_STATS)
+		qdisc_offload_dump_helper(sch, TC_SETUP_QDISC_CODEL, &opt);
+	else
+		dev->netdev_ops->ndo_setup_tc(dev, TC_SETUP_QDISC_CODEL, &opt);
+}
+
 /* This is the specific function called from codel_dequeue()
  * to dequeue a packet from queue. Note: backlog is handled in
  * codel, we dont need to reduce it here.
@@ -193,6 +247,7 @@ static int codel_change(struct Qdisc *sch, struct nlattr *opt,
 	qdisc_tree_reduce_backlog(sch, dropped_pkts, dropped_bytes);
 
 	sch_tree_unlock(sch);
+	codel_offload(sch, TC_CODEL_REPLACE);
 	return 0;
 }
 
@@ -215,6 +270,9 @@ static int codel_init(struct Qdisc *sch, struct nlattr *opt,
 			return err;
 	}
 
+	if (!opt)
+		codel_offload(sch, TC_CODEL_REPLACE);
+
 	if (sch->limit >= 1)
 		sch->flags |= TCQ_F_CAN_BYPASS;
 	else
@@ -229,6 +287,8 @@ static int codel_dump(struct Qdisc *sch, struct sk_buff *skb)
 	codel_time_t ce_threshold;
 	struct nlattr *opts;
 
+	codel_offload(sch, TC_CODEL_STATS);
+
 	opts = nla_nest_start_noflag(skb, TCA_OPTIONS);
 	if (opts == NULL)
 		goto nla_put_failure;
@@ -288,6 +348,11 @@ static void codel_reset(struct Qdisc *sch)
 	codel_vars_init(&q->vars);
 }
 
+static void codel_destroy(struct Qdisc *sch)
+{
+	codel_offload(sch, TC_CODEL_DESTROY);
+}
+
 static struct Qdisc_ops codel_qdisc_ops __read_mostly = {
 	.id		=	"codel",
 	.priv_size	=	sizeof(struct codel_sched_data),
@@ -297,8 +362,10 @@ static struct Qdisc_ops codel_qdisc_ops __read_mostly = {
 	.peek		=	codel_peek,
 	.init		=	codel_init,
 	.reset		=	codel_reset,
+	.destroy	=	codel_destroy,
 	.change 	=	codel_change,
 	.dump		=	codel_dump,
+	.offload_replay	=	codel_offload_replay,
 	.dump_stats	=	codel_dump_stats,
 	.owner		=	THIS_MODULE,
 };
diff --git a/net/sched/sch_fifo.c b/net/sched/sch_fifo.c
index e6bfd39..2d36118 100644
--- a/net/sched/sch_fifo.c
+++ b/net/sched/sch_fifo.c
@@ -56,41 +56,70 @@ static int pfifo_tail_enqueue(struct sk_buff *skb, struct Qdisc *sch,
 	return NET_XMIT_CN;
 }
 
+static void fifo_offload_prepare(struct Qdisc *sch,
+				 struct tc_fifo_qopt_offload *opt)
+{
+	*opt = (struct tc_fifo_qopt_offload) {
+		.command = TC_FIFO_REPLACE,
+		.handle = sch->handle,
+		.parent = sch->parent,
+		.owner = { .sch = sch, .hw_stats = &sch->hw_stats },
+		.limit = READ_ONCE(sch->limit),
+		.byte_limit = sch->ops == &bfifo_qdisc_ops,
+		.head_drop = sch->ops == &pfifo_head_drop_qdisc_ops,
+	};
+}
+
+static int fifo_offload_replay(struct Qdisc *sch, flow_setup_cb_t *cb,
+			     void *priv, struct netlink_ext_ack *extack)
+{
+	struct tc_fifo_qopt_offload opt;
+
+	fifo_offload_prepare(sch, &opt);
+	return cb(TC_SETUP_QDISC_FIFO, &opt, priv);
+}
+
 static void fifo_offload_init(struct Qdisc *sch)
 {
 	struct net_device *dev = qdisc_dev(sch);
-	struct tc_fifo_qopt_offload qopt;
+	struct tc_fifo_qopt_offload qopt = {};
 
 	if (!tc_can_offload(dev) || !dev->netdev_ops->ndo_setup_tc)
 		return;
 
-	qopt.command = TC_FIFO_REPLACE;
-	qopt.handle = sch->handle;
-	qopt.parent = sch->parent;
+	fifo_offload_prepare(sch, &qopt);
 	dev->netdev_ops->ndo_setup_tc(dev, TC_SETUP_QDISC_FIFO, &qopt);
 }
 
 static void fifo_offload_destroy(struct Qdisc *sch)
 {
 	struct net_device *dev = qdisc_dev(sch);
-	struct tc_fifo_qopt_offload qopt;
+	struct tc_fifo_qopt_offload qopt = {};
+	struct tc_qdisc_caps caps;
 
 	if (!tc_can_offload(dev) || !dev->netdev_ops->ndo_setup_tc)
 		return;
 
+	if (sch->ops == &pfifo_head_drop_qdisc_ops) {
+		qdisc_offload_query_caps(dev, TC_SETUP_QDISC_FIFO, &caps, sizeof(caps));
+		if (!caps.device_stage)
+			return;
+	}
 	qopt.command = TC_FIFO_DESTROY;
 	qopt.handle = sch->handle;
 	qopt.parent = sch->parent;
+	qopt.owner = (struct tc_qdisc_offload_owner) { .sch = sch, .hw_stats = &sch->hw_stats };
 	dev->netdev_ops->ndo_setup_tc(dev, TC_SETUP_QDISC_FIFO, &qopt);
 }
 
 static int fifo_offload_dump(struct Qdisc *sch)
 {
-	struct tc_fifo_qopt_offload qopt;
+	struct tc_fifo_qopt_offload qopt = {};
 
 	qopt.command = TC_FIFO_STATS;
 	qopt.handle = sch->handle;
 	qopt.parent = sch->parent;
+	qopt.owner = (struct tc_qdisc_offload_owner) { .sch = sch, .hw_stats = &sch->hw_stats };
 	qopt.stats.bstats = &sch->bstats;
 	qopt.stats.qstats = &sch->qstats;
 
@@ -148,7 +177,16 @@ static int fifo_init(struct Qdisc *sch, struct nlattr *opt,
 static int fifo_hd_init(struct Qdisc *sch, struct nlattr *opt,
 			struct netlink_ext_ack *extack)
 {
-	return __fifo_init(sch, opt, extack);
+	struct tc_qdisc_caps caps;
+	int err = __fifo_init(sch, opt, extack);
+
+	if (err)
+		return err;
+	qdisc_offload_query_caps(qdisc_dev(sch), TC_SETUP_QDISC_FIFO,
+				 &caps, sizeof(caps));
+	if (caps.device_stage)
+		fifo_offload_init(sch);
+	return 0;
 }
 
 static void fifo_destroy(struct Qdisc *sch)
@@ -195,6 +233,7 @@ struct Qdisc_ops pfifo_qdisc_ops __read_mostly = {
 	.reset		=	qdisc_reset_queue,
 	.change		=	fifo_init,
 	.dump		=	fifo_dump,
+	.offload_replay	=	fifo_offload_replay,
 	.owner		=	THIS_MODULE,
 };
 EXPORT_SYMBOL(pfifo_qdisc_ops);
@@ -210,6 +249,7 @@ struct Qdisc_ops bfifo_qdisc_ops __read_mostly = {
 	.reset		=	qdisc_reset_queue,
 	.change		=	fifo_init,
 	.dump		=	fifo_dump,
+	.offload_replay	=	fifo_offload_replay,
 	.owner		=	THIS_MODULE,
 };
 EXPORT_SYMBOL(bfifo_qdisc_ops);
@@ -223,7 +263,9 @@ struct Qdisc_ops pfifo_head_drop_qdisc_ops __read_mostly = {
 	.init		=	fifo_hd_init,
 	.reset		=	qdisc_reset_queue,
 	.change		=	fifo_hd_init,
+	.destroy	=	fifo_destroy,
 	.dump		=	fifo_hd_dump,
+	.offload_replay	=	fifo_offload_replay,
 	.owner		=	THIS_MODULE,
 };
 
diff --git a/net/sched/sch_fq_codel.c b/net/sched/sch_fq_codel.c
index 9ab64b4..7759bd6 100644
--- a/net/sched/sch_fq_codel.c
+++ b/net/sched/sch_fq_codel.c
@@ -67,6 +67,64 @@ struct fq_codel_sched_data {
 	struct list_head old_flows;	/* list of old flows */
 };
 
+static void fq_codel_offload_prepare(struct Qdisc *sch,
+				    struct tc_fq_codel_qopt_offload *opt)
+{
+	struct fq_codel_sched_data *q = qdisc_priv(sch);
+
+	*opt = (struct tc_fq_codel_qopt_offload) {
+		.command = TC_CODEL_REPLACE,
+		.handle = sch->handle,
+		.parent = sch->parent,
+		.owner = { .sch = sch, .hw_stats = &sch->hw_stats },
+		.codel = {
+			.target = q->cparams.target,
+			.interval = q->cparams.interval,
+			.ce_threshold = q->cparams.ce_threshold,
+			.limit = sch->limit,
+			.mtu = q->cparams.mtu,
+			.ecn = q->cparams.ecn,
+			.ce_threshold_selector = q->cparams.ce_threshold_selector,
+			.ce_threshold_mask = q->cparams.ce_threshold_mask,
+		},
+		.flows = q->flows_cnt,
+		.quantum = q->quantum,
+		.memory_limit = q->memory_limit,
+		.drop_batch_size = q->drop_batch_size,
+		.block = q->block,
+	};
+}
+
+static int fq_codel_offload_replay(struct Qdisc *sch, flow_setup_cb_t *cb,
+				 void *priv, struct netlink_ext_ack *extack)
+{
+	struct tc_fq_codel_qopt_offload opt;
+
+	fq_codel_offload_prepare(sch, &opt);
+	return cb(TC_SETUP_QDISC_FQ_CODEL, &opt, priv);
+}
+
+static void fq_codel_offload(struct Qdisc *sch, enum tc_codel_command command)
+{
+	struct net_device *dev = qdisc_dev(sch);
+	struct tc_fq_codel_qopt_offload opt;
+	struct tc_qdisc_caps caps;
+
+	if (command == TC_CODEL_STATS)
+		sch->flags &= ~TCQ_F_OFFLOADED;
+	if (!tc_can_offload(dev) || !dev->netdev_ops->ndo_setup_tc)
+		return;
+	qdisc_offload_query_caps(dev, TC_SETUP_QDISC_FQ_CODEL, &caps, sizeof(caps));
+	if (!caps.device_stage)
+		return;
+	fq_codel_offload_prepare(sch, &opt);
+	opt.command = command;
+	if (command == TC_CODEL_STATS)
+		qdisc_offload_dump_helper(sch, TC_SETUP_QDISC_FQ_CODEL, &opt);
+	else
+		dev->netdev_ops->ndo_setup_tc(dev, TC_SETUP_QDISC_FQ_CODEL, &opt);
+}
+
 static unsigned int fq_codel_hash(const struct fq_codel_sched_data *q,
 				  struct sk_buff *skb)
 {
@@ -491,6 +549,7 @@ static int fq_codel_change(struct Qdisc *sch, struct nlattr *opt,
 	qdisc_tree_reduce_backlog(sch, dropped_pkts, dropped_bytes);
 
 	sch_tree_unlock(sch);
+	fq_codel_offload(sch, TC_CODEL_REPLACE);
 	return 0;
 }
 
@@ -498,6 +557,7 @@ static void fq_codel_destroy(struct Qdisc *sch)
 {
 	struct fq_codel_sched_data *q = qdisc_priv(sch);
 
+	fq_codel_offload(sch, TC_CODEL_DESTROY);
 	tcf_block_put(q->block);
 	kvfree(q->backlogs);
 	kvfree(q->flows);
@@ -560,6 +620,8 @@ static int fq_codel_init(struct Qdisc *sch, struct nlattr *opt,
 		sch->flags |= TCQ_F_CAN_BYPASS;
 	else
 		sch->flags &= ~TCQ_F_CAN_BYPASS;
+	if (!opt)
+		fq_codel_offload(sch, TC_CODEL_REPLACE);
 	return 0;
 
 alloc_failure:
@@ -576,6 +638,8 @@ static int fq_codel_dump(struct Qdisc *sch, struct sk_buff *skb)
 	codel_time_t ce_threshold;
 	struct nlattr *opts;
 
+	fq_codel_offload(sch, TC_CODEL_STATS);
+
 	opts = nla_nest_start_noflag(skb, TCA_OPTIONS);
 	if (opts == NULL)
 		goto nla_put_failure;
@@ -770,6 +834,7 @@ static struct Qdisc_ops fq_codel_qdisc_ops __read_mostly = {
 	.destroy	=	fq_codel_destroy,
 	.change		=	fq_codel_change,
 	.dump		=	fq_codel_dump,
+	.offload_replay	=	fq_codel_offload_replay,
 	.dump_stats =	fq_codel_dump_stats,
 	.owner		=	THIS_MODULE,
 };
diff --git a/net/sched/sch_htb.c b/net/sched/sch_htb.c
index 58fe309..36ae25a 100644
--- a/net/sched/sch_htb.c
+++ b/net/sched/sch_htb.c
@@ -1043,11 +1043,95 @@ static void htb_work_func(struct work_struct *work)
 	rcu_read_unlock();
 }
 
-static int htb_offload(struct net_device *dev, struct tc_htb_qopt_offload *opt)
+/* The same effective values feed a prospective offload and native commit. */
+struct htb_offload_params {
+	struct psched_ratecfg rate;
+	struct psched_ratecfg ceil;
+	s64 buffer;
+	s64 cbuffer;
+	u32 quantum;
+	u32 prio;
+};
+
+static void htb_offload_prepare(struct Qdisc *sch, struct htb_class *cl,
+				struct htb_class *parent,
+				const struct htb_offload_params *next,
+				struct tc_htb_qopt_offload *opt)
+{
+	struct htb_sched *q = qdisc_priv(sch);
+
+	opt->owner = (struct tc_qdisc_offload_owner) {
+		.sch = sch,
+		.class = (unsigned long)cl,
+		.hw_stats = cl ? &cl->hw_stats : &sch->hw_stats,
+	};
+	opt->root_handle = sch->handle;
+	opt->default_class = TC_H_MIN(q->defcls);
+	opt->explicit_offload = q->offload || opt->command == TC_HTB_CREATE;
+	opt->parent_class = (unsigned long)parent;
+	if (!cl)
+		return;
+	opt->leaf = !cl->level;
+	opt->child = cl->level ? NULL : cl->leaf.q;
+	opt->ratecfg = next ? next->rate : cl->rate;
+	opt->ceilcfg = next ? next->ceil : cl->ceil;
+	opt->buffer_ns = next ? next->buffer : cl->buffer;
+	opt->ceil_buffer_ns = next ? next->cbuffer : cl->cbuffer;
+	opt->effective_quantum = next ? next->quantum : cl->quantum;
+	opt->effective_prio = next ? next->prio : cl->prio;
+}
+
+static int htb_offload(struct Qdisc *sch, struct htb_class *cl,
+			struct htb_class *parent,
+			const struct htb_offload_params *next,
+			struct tc_htb_qopt_offload *opt)
 {
+	struct net_device *dev = qdisc_dev(sch);
+
+	htb_offload_prepare(sch, cl, parent, next, opt);
 	return dev->netdev_ops->ndo_setup_tc(dev, TC_SETUP_QDISC_HTB, opt);
 }
 
+static int htb_class_offload_replay(struct Qdisc *sch, unsigned long arg,
+				    flow_setup_cb_t *cb, void *priv,
+				    struct netlink_ext_ack *extack)
+{
+	struct htb_class *cl = (struct htb_class *)arg;
+	struct tc_htb_qopt_offload opt = {
+		.command = TC_HTB_NODE_MODIFY,
+		.classid = TC_H_MIN(cl->common.classid),
+		.parent_classid = cl->parent ? TC_H_MIN(cl->parent->common.classid) :
+			TC_HTB_CLASSID_ROOT,
+		.rate = cl->rate.rate_bytes_ps,
+		.ceil = cl->ceil.rate_bytes_ps,
+		.quantum = cl->quantum,
+		.prio = cl->prio,
+		.extack = extack,
+	};
+
+	htb_offload_prepare(sch, cl, cl->parent, NULL, &opt);
+	if (!cl->level && cl->leaf.offload_queue)
+		opt.qid = cl->leaf.offload_queue - qdisc_dev(sch)->_tx;
+	return cb(TC_SETUP_QDISC_HTB, &opt, priv);
+}
+
+static int htb_offload_replay(struct Qdisc *sch, flow_setup_cb_t *cb,
+			    void *priv, struct netlink_ext_ack *extack)
+{
+	struct htb_sched *q = qdisc_priv(sch);
