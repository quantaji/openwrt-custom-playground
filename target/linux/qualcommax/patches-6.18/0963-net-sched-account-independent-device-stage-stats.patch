 }
 
@@ -2060,6 +2063,7 @@ err_kill_estimator:
 	gen_kill_estimator(&cl->rate_est);
 err_block_put:
 	tcf_block_put(cl->block);
+	gnet_stats_hw_close(&cl->hw_stats);
 	kfree(cl);
 failure:
 	return err;
