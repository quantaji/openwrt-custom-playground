+SRCU_NOTIFIER_HEAD_STATIC(tcf_block_chain);
+
+int tcf_block_register_notifier(struct notifier_block *nb)
+{
+	return srcu_notifier_chain_register(&tcf_block_chain, nb);
+}
+EXPORT_SYMBOL_GPL(tcf_block_register_notifier);
+
+int tcf_block_unregister_notifier(struct notifier_block *nb)
+{
+	return srcu_notifier_chain_unregister(&tcf_block_chain, nb);
+}
+EXPORT_SYMBOL_GPL(tcf_block_unregister_notifier);
+
+void tcf_block_read_state(struct tcf_block *block, struct tcf_block_state *state)
+{
+	mutex_lock(&block->lock);
+	state->active = block->mutation_active;
+	state->sequence = block->mutation_sequence;
+	mutex_unlock(&block->lock);
+}
+EXPORT_SYMBOL_GPL(tcf_block_read_state);
+
+static void tcf_mutation_begin(struct tcf_block *block)
+{
+	mutex_lock(&block->lock);
+	block->mutation_active++;
+	mutex_unlock(&block->lock);
+}
+
+static void tcf_mutation_end(struct tcf_block *block)
+{
+	struct tcf_block_event event = { .block = block };
+
+	mutex_lock(&block->lock);
+	block->mutation_active--;
+	event.sequence = ++block->mutation_sequence;
+	mutex_unlock(&block->lock);
+	/* The caller still owns its block reference, but none of the native
+	 * proto/chain/callback locks. This channel does not count HW offloads.
+	 */
+	srcu_notifier_call_chain(&tcf_block_chain, TCF_BLOCK_CHANGE, &event);
+}
