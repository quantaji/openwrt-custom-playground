+{
+	struct flow_block_cb *block_cb;
+	int err = -ENOENT;
+
+	ASSERT_RTNL();
+	down_write(&block->cb_lock);
+	list_for_each_entry(block_cb, &block->flow_block.cb_list, list) {
+		if (block_cb->cb != cb || block_cb->cb_priv != cb_priv)
+			continue;
+		err = tcf_block_playback_offloads(block, cb, cb_priv, add,
+						 tcf_block_offload_in_use(block),
+						 extack);
+		break;
+	}
+	up_write(&block->cb_lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(tcf_block_replay_bound);
