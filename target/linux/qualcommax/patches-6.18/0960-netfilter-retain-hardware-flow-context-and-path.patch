+EXPORT_SYMBOL_GPL(nf_flow_hw_path_get);
+
+void nf_flow_hw_path_put(struct nf_flow_hw_path *path)
+{
+	int dir, i;
+
+	if (!path || !refcount_dec_and_test(&path->refs))
+		return;
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		struct nf_flow_hw_path_dir *p = &path->dir[dir];
+
+		for (i = 0; i < p->stack.num_paths; i++)
+			dev_put((struct net_device *)p->stack.path[i].dev);
+		dst_release(p->route.dst);
+	}
+	kfree(path);
+}
+EXPORT_SYMBOL_GPL(nf_flow_hw_path_put);
+
+int nf_flow_hw_path_validate(const struct nf_flow_hw_path *path)
+{
+	int dir, i, err = -ESTALE;
+
+	ASSERT_RTNL();
+	if (!path)
+		return -EAGAIN;
+
+	rcu_read_lock();
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct nf_flow_hw_path_dir *p = &path->dir[dir];
+		const struct nf_flow_route_tuple *in = &path->dir[!dir].route;
+		struct dst_entry *dst = p->route.dst;
+		struct net_device_path_stack stack = {};
+		struct nft_forward_info info = {};
+		unsigned char ha[ETH_ALEN];
+		u16 mtu;
+
+		if (!dst_check(dst, p->dst_cookie) ||
+		    READ_ONCE(dst->dev->reg_state) != NETREG_REGISTERED)
+			goto out;
+		for (i = 0; i < p->stack.num_paths; i++)
+			if (READ_ONCE(p->stack.path[i].dev->reg_state) != NETREG_REGISTERED)
+				goto out;
+
+		if (nft_dev_fill_forward_path(dst, &p->neighbour, ha, &stack) < 0) {
+			err = -EAGAIN;
+			goto out;
+		}
+		nft_dev_path_info(&stack, &info, ha, true);
+		if (!info.indev) {
+			err = -EAGAIN;
+			goto out;
+		}
+		if (stack.num_paths != p->stack.num_paths)
+			goto out;
+		for (i = 0; i < stack.num_paths; i++) {
+			const struct net_device_path *old = &p->stack.path[i];
+			const struct net_device_path *now = &stack.path[i];
+
+			if (old->type != now->type || old->dev != now->dev)
+				goto out;
+			switch (old->type) {
+			case DEV_PATH_ETHERNET:
+				break;
+			case DEV_PATH_VLAN:
+			case DEV_PATH_PPPOE:
+				if (old->encap.id != now->encap.id ||
+				    old->encap.proto != now->encap.proto)
+					goto out;
+				if (old->type == DEV_PATH_PPPOE &&
+				    !ether_addr_equal(old->encap.h_dest, now->encap.h_dest))
+					goto out;
+				break;
+			case DEV_PATH_BRIDGE:
+				if (old->bridge.vlan_mode != now->bridge.vlan_mode ||
+				    old->bridge.vlan_id != now->bridge.vlan_id ||
+				    old->bridge.vlan_proto != now->bridge.vlan_proto)
+					goto out;
+				break;
+			case DEV_PATH_DSA:
+				if (old->dsa.port != now->dsa.port ||
+				    old->dsa.proto != now->dsa.proto)
+					goto out;
+				break;
+			default:
+				err = -EAGAIN;
+				goto out;
+			}
+		}
+		if (info.indev->ifindex != in->in.ifindex ||
+		    info.num_encaps != in->in.num_encaps ||
+		    info.ingress_vlans != in->in.ingress_vlans)
+			goto out;
+		for (i = 0; i < info.num_encaps; i++)
+			if (info.encap[i].id != in->in.encap[i].id ||
+			    info.encap[i].proto != in->in.encap[i].proto)
+				goto out;
+		if (info.xmit_type == FLOW_OFFLOAD_XMIT_DIRECT) {
+			if (p->route.xmit_type != FLOW_OFFLOAD_XMIT_DIRECT ||
+			    info.outdev->ifindex != p->route.out.ifindex ||
+			    info.hw_outdev->ifindex != p->route.out.hw_ifindex ||
+			    !ether_addr_equal(info.h_source, p->route.out.h_source) ||
+			    !ether_addr_equal(info.h_dest, p->route.out.h_dest))
+				goto out;
+		} else if (p->route.xmit_type != nft_xmit_type(dst)) {
+			goto out;
+		}
+		if (p->l3proto == NFPROTO_IPV6)
+			mtu = ip6_dst_mtu_maybe_forward(dst, true);
+		else
+			mtu = ip_dst_mtu_maybe_forward(dst, true);
+		if (mtu != p->mtu)
+			goto out;
+	}
+	err = 0;
+out:
+	rcu_read_unlock();
+	return err;
+}
+EXPORT_SYMBOL_GPL(nf_flow_hw_path_validate);
