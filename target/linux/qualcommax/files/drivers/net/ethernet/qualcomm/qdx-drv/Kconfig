config QDX
	tristate "Qualcomm IPQ8074 NSS execution driver"
	depends on ARCH_QCOM && ARM64 && OF
	depends on HAS_DMA && COMMON_CLK && RESET_CONTROLLER && REGULATOR
	depends on MAILBOX && QCOM_APCS_IPC
	depends on !MODULE_FORCE_UNLOAD
	select FW_LOADER
	select CRYPTO_LIB_SHA256
	help
	  Start both IPQ8074 NSS cores with the locally installed 11.4 firmware
	  and provide their command, memory and wired packet transport. Linux
	  networking and the native Ethernet drivers retain configuration
	  ownership. Independent QDX subsystem modules acquire and withdraw
	  hardware delegation while firmware keeps running.

	  The module is called qdx-drv. Once loaded it remains resident until
	  system shutdown; a stopped NSS instance cannot restart in that boot.
